# local.env.example: settings for snell-skills that differ per machine.
#
# Copy this file to local.env (same folder) and fill in your values:
#   cp local.env.example local.env
# local.env is gitignored, so your personal paths never get committed.
#
# If you installed the skills somewhere else (plugin or npx skills), put the
# file at ~/.config/snell-skills/local.env instead, or point the
# SNELL_SKILLS_ENV environment variable at it.
#
# Format: KEY=VALUE, one per line. The file is read, never run as a script.
# A leading ~/ or $HOME/ is expanded to your home folder.

# Folder where the learning-doc skill saves its HTML docs and PDFs.
# Required by the learning-doc skill and the /learning-pdf command.
LEARNING_DOC_DIR="$HOME/path/to/your/learning-docs"
