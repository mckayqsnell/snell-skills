{
  "description": "At the start of a new session, offer to keep a learning doc.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}\"/hooks/learning-doc-prompt.txt"
          }
        ]
      }
    ]
  }
}
